{
  "functions": {
    "api/sync.js": {
      "includeFiles": "public/data/videos.json"
    },
    "api/library.js": {
      "includeFiles": "public/data/videos.json"
    },
    "api/queue.js": {
      "includeFiles": "public/data/videos.json"
    },
    "api/done.js": {
      "includeFiles": "public/data/videos.json"
    },
    "api/downloaded.js": {
      "includeFiles": "public/data/videos.json"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
